import React, { useState, useEffect } from 'react';
import { initializeApp } from 'firebase/app';
import { 
  getFirestore, 
  doc, 
  updateDoc, 
  setDoc,
  onSnapshot
} from 'firebase/firestore';
import { 
  getAuth, 
  signInAnonymously, 
  signInWithCustomToken, 
  onAuthStateChanged 
} from 'firebase/auth';
import { 
  ExternalLink, 
  Tv, 
  Gamepad2, 
  MessageSquare, 
  Youtube, 
  Star, 
  Copy, 
  Check,
  User,
  Link as LinkIcon,
  Trash2,
  Plus,
  Layout,
  Play,
  Info,
  Flame,
  Camera,
  Settings,
  Save,
  X
} from 'lucide-react';

// --- CONFIGURACIÓN DE FIREBASE ---
const firebaseConfig = JSON.parse(window.__firebase_config);
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof window.__app_id !== 'undefined' ? window.__app_id : 'mundolinks-multiverso';

export default function App() {
  const [user, setUser] = useState(null);
  const [activeTab, setActiveTab] = useState('links');
  const [copySuccess, setCopySuccess] = useState(false);
  
  const [profileData, setProfileData] = useState({
    displayName: 'Shinobi Maestro',
    bio: 'Coleccionista de mundos paralelos y guerrero de nivel 99.',
    bannerUrl: 'https://images.unsplash.com/photo-1578632738981-4330c7091f3d?auto=format&fit=crop&q=80&w=1000',
    avatarUrl: '',
    videoUrl: 'https://www.youtube.com/embed/dQw4w9WgXcQ',
    notes: '',
    links: [
      { id: 1, title: 'Mi canal de Stream', url: 'https://twitch.tv', icon: 'Gamepad2', color: 'bg-purple-600' },
      { id: 2, title: 'Comunidad Isekai', url: '#', icon: 'MessageSquare', color: 'bg-blue-500' }
    ],
    isekaiList: [
      { id: 1, title: 'Mushoku Tensei', rating: '9.2', img: 'https://cdn.myanimelist.net/images/anime/1530/117776.jpg', tags: ['Magia', 'Reencarnación'] },
      { id: 2, title: 'Re:Zero', rating: '8.7', img: 'https://cdn.myanimelist.net/images/anime/11/79410.jpg', tags: ['Psicológico', 'Bucle'] },
      { id: 3, title: 'Overlord', rating: '8.0', img: 'https://cdn.myanimelist.net/images/anime/7/74631.jpg', tags: ['OP MC', 'Fantasía'] },
      { id: 4, title: 'That Time I Got Reincarnated as a Slime', rating: '8.5', img: 'https://cdn.myanimelist.net/images/anime/1106/94653.jpg', tags: ['Construcción de Reino', 'Slime'] }
    ]
  });

  // --- AUTENTICACIÓN ---
  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof window.__initial_auth_token !== 'undefined' && window.__initial_auth_token) {
          await signInWithCustomToken(auth, window.__initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (error) {
        console.error("Error Auth:", error);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, (currentUser) => setUser(currentUser));
    return () => unsubscribe();
  }, []);

  // --- PERSISTENCIA FIREBASE ---
  useEffect(() => {
    if (!user) return;
    const profileRef = doc(db, 'artifacts', appId, 'users', user.uid, 'profile', 'info');
    const unsubscribe = onSnapshot(profileRef, (docSnap) => {
      if (docSnap.exists()) {
        const data = docSnap.data();
        setProfileData(prev => ({ ...prev, ...data }));
      } else {
        setDoc(profileRef, profileData);
      }
    }, (error) => console.error("Firestore Error:", error));
    return () => unsubscribe();
  }, [user]);

  const syncData = async (newData) => {
    if (!user) return;
    const profileRef = doc(db, 'artifacts', appId, 'users', user.uid, 'profile', 'info');
    try {
      await updateDoc(profileRef, newData);
    } catch (e) {
      console.error("Error syncing:", e);
    }
  };

  const handleCopy = (text) => {
    const textArea = document.createElement("textarea");
    textArea.value = text;
    document.body.appendChild(textArea);
    textArea.select();
    document.execCommand('copy');
    setCopySuccess(true);
    setTimeout(() => setCopySuccess(false), 2000);
    document.body.removeChild(textArea);
  };

  const getIcon = (iconName, size = 20) => {
    const icons = { Tv, MessageSquare, Youtube, Star, LinkIcon, Gamepad2, Layout, Flame, User, Settings, Play, Info, Camera, Save, Trash2, Plus, X };
    const IconComp = icons[iconName] || LinkIcon;
    return <IconComp size={size} />;
  };

  // --- MANEJADORES DE EDICIÓN ---
  const addLink = () => {
    const newLinks = [...profileData.links, { id: Date.now(), title: 'Nuevo Link', url: 'https://', icon: 'LinkIcon', color: 'bg-gray-700' }];
    setProfileData(prev => ({ ...prev, links: newLinks }));
    syncData({ links: newLinks });
  };

  const deleteLink = (id) => {
    const newLinks = profileData.links.filter(l => l.id !== id);
    setProfileData(prev => ({ ...prev, links: newLinks }));
    syncData({ links: newLinks });
  };

  const updateLinkDetail = (id, field, value) => {
    const newLinks = profileData.links.map(l => l.id === id ? { ...l, [field]: value } : l);
    setProfileData(prev => ({ ...prev, links: newLinks }));
    syncData({ links: newLinks });
  };

  return (
    <div className="min-h-screen bg-[#080808] text-white font-sans selection:bg-[#ff7a00]">
      
      {/* NAVEGACIÓN PRINCIPAL */}
      <nav className="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-[#121212]/80 backdrop-blur-xl border border-white/10 p-2 rounded-2xl flex gap-2 shadow-2xl">
        {[
          { id: 'links', icon: 'Layout', label: 'Portal' },
          { id: 'isekai', icon: 'Flame', label: 'Isekais' },
          { id: 'perfil', icon: 'User', label: 'Perfil' },
          { id: 'ajustes', icon: 'Settings', label: 'Ajustes' }
        ].map(tab => (
          <button
            key={tab.id}
            onClick={() => setActiveTab(tab.id)}
            className={`flex items-center gap-2 px-4 py-2 rounded-xl transition-all ${
              activeTab === tab.id ? 'bg-[#ff7a00] text-black font-black' : 'text-gray-500 hover:text-white'
            }`}
          >
            {getIcon(tab.icon, 18)}
            <span className="hidden md:inline text-[10px] uppercase tracking-tighter">{tab.label}</span>
          </button>
        ))}
      </nav>

      <div className="pb-24">
        
        {/* PORTAL DE ENLACES */}
        {activeTab === 'links' && (
          <div className="max-w-xl mx-auto px-4 py-12 animate-in fade-in duration-500">
            <div className="flex flex-col items-center text-center mb-10">
              <div className="w-24 h-24 rounded-full border-4 border-[#ff7a00] p-1 mb-4 shadow-[0_0_20px_rgba(255,122,0,0.3)] overflow-hidden">
                {profileData.avatarUrl ? (
                  <img src={profileData.avatarUrl} className="w-full h-full object-cover rounded-full" />
                ) : (
                  <div className="w-full h-full rounded-full bg-[#111] flex items-center justify-center text-3xl font-black">
                    {profileData.displayName.charAt(0)}
                  </div>
                )}
              </div>
              <h1 className="text-3xl font-black italic uppercase tracking-tighter">{profileData.displayName}</h1>
              <p className="text-gray-500 text-sm mt-2">{profileData.bio}</p>
            </div>

            <div className="space-y-4">
              {profileData.links.map(link => (
                <a
                  key={link.id}
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="group w-full bg-[#121212] hover:bg-[#181818] border border-white/5 p-4 rounded-2xl flex items-center gap-4 transition-all hover:scale-[1.02] shadow-lg"
                >
                  <div className={`w-12 h-12 ${link.color} rounded-xl flex items-center justify-center shadow-lg group-hover:rotate-6 transition-transform text-white`}>
                    {getIcon(link.icon)}
                  </div>
                  <span className="flex-1 font-black text-sm uppercase italic">{link.title}</span>
                  <ExternalLink size={16} className="text-gray-600 group-hover:text-[#ff7a00]" />
                </a>
              ))}
            </div>
          </div>
        )}

        {/* LISTA ISEKAI */}
        {activeTab === 'isekai' && (
          <div className="max-w-4xl mx-auto px-6 py-12 animate-in slide-in-from-right-4 duration-500">
            <div className="flex items-center gap-3 mb-8">
              <Flame className="text-[#ff7a00]" size={32} />
              <h2 className="text-4xl font-black italic uppercase tracking-tighter">Isekai Central</h2>
            </div>
            
            <div className="grid grid-cols-2 md:grid-cols-4 gap-6">
              {profileData.isekaiList.map(anime => (
                <div key={anime.id} className="bg-[#121212] rounded-2xl overflow-hidden border border-white/5 group">
                  <div className="relative aspect-[2/3] overflow-hidden">
                    <img src={anime.img} className="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt={anime.title} />
                    <div className="absolute top-2 right-2 bg-black/80 backdrop-blur-md px-2 py-1 rounded-lg flex items-center gap-1 text-[10px] font-black text-[#ff7a00]">
                      <Star size={10} fill="currentColor" /> {anime.rating}
                    </div>
                  </div>
                  <div className="p-4">
                    <h3 className="font-black text-xs uppercase line-clamp-1 italic">{anime.title}</h3>
                    <div className="flex flex-wrap gap-1 mt-2">
                      {anime.tags.map(tag => (
                        <span key={tag} className="text-[8px] bg-white/5 px-2 py-0.5 rounded text-gray-400 uppercase font-bold">{tag}</span>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* PERFIL PRO */}
        {activeTab === 'perfil' && (
          <div className="animate-in fade-in duration-500">
            <div className="relative h-48 md:h-64 overflow-hidden bg-gray-800">
              <img src={profileData.bannerUrl} className="w-full h-full object-cover opacity-60" alt="Banner" />
              <div className="absolute inset-0 bg-gradient-to-t from-[#080808] to-transparent"></div>
            </div>

            <div className="max-w-3xl mx-auto px-6 -mt-16 relative z-10">
              <div className="flex flex-col md:flex-row items-center md:items-end gap-6 mb-10">
                <div className="w-32 h-32 rounded-3xl bg-[#111] border-4 border-[#080808] overflow-hidden shadow-2xl">
                  {profileData.avatarUrl ? (
                    <img src={profileData.avatarUrl} className="w-full h-full object-cover" />
                  ) : (
                    <div className="w-full h-full flex items-center justify-center text-5xl font-black text-[#ff7a00]">
                      {profileData.displayName.charAt(0)}
                    </div>
                  )}
                </div>
                <div className="flex-1 text-center md:text-left pb-2">
                  <h2 className="text-4xl font-black uppercase italic tracking-tighter">{profileData.displayName}</h2>
                  <p className="text-[#ff7a00] font-black uppercase text-xs tracking-widest mt-1">Nivel 99 • Rango S</p>
                </div>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div className="md:col-span-2 space-y-6">
                  <div className="bg-[#121212] p-6 rounded-3xl border border-white/5 text-left">
                    <h4 className="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-4">Información del Guerrero</h4>
                    <p className="text-gray-300 leading-relaxed font-medium whitespace-pre-wrap">{profileData.bio}</p>
                  </div>

                  <div className="bg-[#121212] p-6 rounded-3xl border border-white/5 overflow-hidden text-left">
                    <h4 className="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-4 flex items-center gap-2">
                      <Play size={14} className="text-[#ff7a00]" /> Tráiler del Personaje
                    </h4>
                    <div className="aspect-video rounded-2xl overflow-hidden bg-black shadow-inner">
                      <iframe 
                        className="w-full h-full"
                        src={profileData.videoUrl} 
                        title="Video player" 
                        frameBorder="0" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                        allowFullScreen
                      ></iframe>
                    </div>
                  </div>
                </div>

                <div className="space-y-6">
                  <div className="bg-gradient-to-br from-[#ff7a00] to-orange-800 p-6 rounded-3xl text-black text-left">
                    <h4 className="font-black uppercase text-[10px] tracking-widest opacity-70">Poder Total</h4>
                    <p className="text-3xl font-black italic">894,200</p>
                    <div className="h-1 bg-black/20 mt-4 rounded-full overflow-hidden">
                      <div className="w-3/4 h-full bg-black"></div>
                    </div>
                  </div>
                  
                  <div className="bg-[#121212] p-6 rounded-3xl border border-white/5 text-left">
                    <h4 className="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-4">Notas Ninja</h4>
                    <p className="text-xs text-gray-400 line-clamp-6 italic whitespace-pre-wrap">{profileData.notes || 'Sin pergaminos guardados...'}</p>
                    <button 
                        onClick={() => setActiveTab('ajustes')}
                        className="mt-4 text-[10px] font-black text-[#ff7a00] uppercase hover:underline"
                    >
                        Editar Notas
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* AJUSTES */}
        {activeTab === 'ajustes' && (
          <div className="max-w-2xl mx-auto px-6 py-12 animate-in zoom-in-95 duration-300 text-left">
            <h2 className="text-3xl font-black uppercase italic mb-8 border-b-2 border-[#ff7a00] pb-2 inline-block">Forja de Datos</h2>
            
            <div className="space-y-8">
              {/* Info General */}
              <section className="bg-[#121212] p-6 rounded-3xl border border-white/5 space-y-4 shadow-xl">
                <h3 className="text-xs font-black uppercase text-[#ff7a00] tracking-widest mb-2">Identidad</h3>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div className="space-y-1">
                    <label className="text-[10px] font-black uppercase text-gray-600">Nombre</label>
                    <input 
                      value={profileData.displayName}
                      onChange={(e) => {
                        const val = e.target.value;
                        setProfileData(p => ({...p, displayName: val}));
                        syncData({displayName: val});
                      }}
                      className="w-full bg-black/40 border border-white/5 rounded-xl p-3 font-bold outline-none focus:border-[#ff7a00]"
                    />
                  </div>
                  <div className="space-y-1">
                    <label className="text-[10px] font-black uppercase text-gray-600">URL Foto Perfil</label>
                    <input 
                      value={profileData.avatarUrl}
                      onChange={(e) => {
                        const val = e.target.value;
                        setProfileData(p => ({...p, avatarUrl: val}));
                        syncData({avatarUrl: val});
                      }}
                      className="w-full bg-black/40 border border-white/5 rounded-xl p-3 text-xs outline-none focus:border-[#ff7a00]"
                    />
                  </div>
                </div>
                <div className="space-y-1">
                    <label className="text-[10px] font-black uppercase text-gray-600">Bio / Descripción</label>
                    <textarea 
                      value={profileData.bio}
                      onChange={(e) => {
                        const val = e.target.value;
                        setProfileData(p => ({...p, bio: val}));
                        syncData({bio: val});
                      }}
                      className="w-full bg-black/40 border border-white/5 rounded-xl p-3 text-sm h-24 outline-none focus:border-[#ff7a00]"
                    />
                </div>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div className="space-y-1">
                    <label className="text-[10px] font-black uppercase text-gray-600">URL Banner</label>
                    <input 
                      value={profileData.bannerUrl}
                      onChange={(e) => {
                        const val = e.target.value;
                        setProfileData(p => ({...p, bannerUrl: val}));
                        syncData({bannerUrl: val});
                      }}
                      className="w-full bg-black/40 border border-white/5 rounded-xl p-3 text-xs outline-none focus:border-[#ff7a00]"
                    />
                  </div>
                  <div className="space-y-1">
                    <label className="text-[10px] font-black uppercase text-gray-600">YouTube Embed URL</label>
                    <input 
                      value={profileData.videoUrl}
                      onChange={(e) => {
                        const val = e.target.value;
                        setProfileData(p => ({...p, videoUrl: val}));
                        syncData({videoUrl: val});
                      }}
                      className="w-full bg-black/40 border border-white/5 rounded-xl p-3 text-xs outline-none focus:border-[#ff7a00]"
                    />
                  </div>
                </div>
              </section>

              {/* Editor de Enlaces */}
              <section className="bg-[#121212] p-6 rounded-3xl border border-white/5 space-y-4">
                <div className="flex justify-between items-center mb-2">
                  <h3 className="text-xs font-black uppercase text-[#ff7a00] tracking-widest">Gestionar Enlaces</h3>
                  <button onClick={addLink} className="flex items-center gap-1 text-[10px] font-black bg-[#ff7a00] text-black px-3 py-1 rounded-full uppercase">
                    <Plus size={12} /> Añadir
                  </button>
                </div>
                <div className="space-y-3">
                  {profileData.links.map(link => (
                    <div key={link.id} className="bg-black/40 border border-white/5 p-4 rounded-2xl flex flex-col gap-3 relative">
                      <button 
                        onClick={() => deleteLink(link.id)}
                        className="absolute top-4 right-4 text-red-500 hover:text-red-400"
                      >
                        <Trash2 size={16} />
                      </button>
                      <div className="grid grid-cols-2 gap-2 mr-8">
                        <input 
                          value={link.title}
                          placeholder="Título"
                          onChange={(e) => updateLinkDetail(link.id, 'title', e.target.value)}
                          className="bg-white/5 border border-white/10 p-2 rounded-lg text-xs font-bold outline-none"
                        />
                        <select 
                          value={link.icon}
                          onChange={(e) => updateLinkDetail(link.id, 'icon', e.target.value)}
                          className="bg-white/5 border border-white/10 p-2 rounded-lg text-xs outline-none"
                        >
                          {['LinkIcon', 'Youtube', 'Gamepad2', 'Tv', 'MessageSquare', 'Star', 'Instagram', 'Twitter'].map(ic => (
                            <option key={ic} value={ic}>{ic}</option>
                          ))}
                        </select>
                      </div>
                      <input 
                        value={link.url}
                        placeholder="URL (https://...)"
                        onChange={(e) => updateLinkDetail(link.id, 'url', e.target.value)}
                        className="bg-white/5 border border-white/10 p-2 rounded-lg text-[10px] outline-none"
                      />
                    </div>
                  ))}
                </div>
              </section>

              {/* Notas */}
              <section className="bg-[#121212] p-6 rounded-3xl border border-white/5">
                <div className="flex justify-between items-center mb-4">
                    <label className="text-[10px] font-black uppercase text-gray-600">Pergamino de Notas</label>
                    <button onClick={() => handleCopy(profileData.notes)} className="text-[#ff7a00] p-1">
                        {copySuccess ? <Check size={16} /> : <Copy size={16} />}
                    </button>
                </div>
                <textarea 
                    value={profileData.notes}
                    onChange={(e) => {
                        const val = e.target.value;
                        setProfileData(p => ({...p, notes: val}));
                        syncData({notes: val});
                    }}
                    className="w-full bg-black/40 border border-white/5 rounded-2xl p-4 h-32 text-sm outline-none focus:border-[#ff7a00] resize-none font-mono"
                    placeholder="Escribe aquí tus planes de conquista..."
                />
              </section>

              <button 
                onClick={() => setActiveTab('links')}
                className="w-full py-4 bg-[#ff7a00] text-black font-black uppercase tracking-widest rounded-2xl shadow-lg shadow-[#ff7a00]/20 flex items-center justify-center gap-2"
              >
                {getIcon('Save', 20)} Finalizar Edición
              </button>
            </div>
          </div>
        )}

      </div>

      <footer className="text-center opacity-30 py-8">
        <p className="text-[9px] font-black uppercase tracking-[0.4em]">SISTEMA MULTIVERSO V2.1</p>
      </footer>
    </div>
  );
}
